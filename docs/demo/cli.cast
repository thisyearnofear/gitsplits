[23.494082, "o", "\u001b[1;36m# 3. Tier auto-routing — show how thresholds drive the autonomy decision\u001b[0m\r\n"]
[27.580816, "o", "\u001b[1;32m$\u001b[0m  amount=$250 → "]
[27.710518, "o", "tier T0 — Amount $250 <= $500 with no risk flags; fully autonomous, no human approval needed.\r\n"]
[30.835174, "o", "\u001b[1;32m$\u001b[0m  amount=$7500 → "]
[30.948708, "o", "tier T2 — Amount $7,500 in $5k-$25k band; finance + compliance both approve.\r\n"]
[34.074413, "o", "\u001b[1;32m$\u001b[0m  amount=$50000 → "]
[34.20623, "o", "tier T3 — Amount $50,000 exceeds $25k threshold; requires finance + compliance + exec sponsor.\r\n"]
